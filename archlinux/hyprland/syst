#!/bin/bash

# 系统状态监控工具
# 显示：电池状态、CPU占用、内存使用、磁盘空间、时间和网络状态

# 文本颜色定义
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
MAGENTA="\033[1;35m"
CYAN="\033[1;36m"
RESET="\033[0m"

# 获取终端宽度
TERM_WIDTH=$(tput cols)

# 分隔线函数
print_separator() {
    printf "${CYAN}%${TERM_WIDTH}s${RESET}\n" | tr ' ' '─'
}

# 带图标的标题函数
print_section() {
    printf "${MAGENTA}%s${RESET}\n" "$1"
}

# 状态信息函数
print_info() {
    printf "  ${YELLOW}%-12s${RESET} %s\n" "$1:" "$2"
}

# 进度条函数
progress_bar() {
    local value=$1
    local max=$2
    local width=20
    local filled=$((value * width / max))
    local empty=$((width - filled))
    
    printf "${GREEN}"
    printf "%${filled}s" | tr ' ' '■'
    printf "${RED}"
    printf "%${empty}s" | tr ' ' '□'
    printf "${RESET} %3d%%" "$((value * 100 / max))"
}

# 获取电池信息
get_battery_info() {
    local bat_path="/sys/class/power_supply"
    local battery_info=""
    
    # 查找电池设备
    for bat in $(ls $bat_path | grep -i BAT); do
        local capacity=$(cat $bat_path/$bat/capacity 2>/dev/null)
        local status=$(cat $bat_path/$bat/status 2>/dev/null)
        
        if [ -n "$capacity" ]; then
            local status_icon="?"
            [ "$status" == "Charging" ] && status_icon="⚡"
            [ "$status" == "Discharging" ] && status_icon="▼"
            [ "$status" == "Full" ] && status_icon="✓"
            
            battery_info+="${status_icon} ${capacity}% "
        fi
    done
    
    if [ -z "$battery_info" ]; then
        echo "N/A (台式机?)"
    else
        echo "$battery_info"
    fi
}

# 获取CPU使用率
get_cpu_usage() {
    # 获取两次CPU数据计算差值
    local cpu1=($(head -n1 /proc/stat | awk '{for(i=2;i<=NF;i++) sum+=$i; print $2+$3+$4+$6+$7+$8, $5, sum}'))
    sleep 0.5
    local cpu2=($(head -n1 /proc/stat | awk '{for(i=2;i<=NF;i++) sum+=$i; print $2+$3+$4+$6+$7+$8, $5, sum}'))
    
    # 计算使用率
    local diff_idle=$((cpu2[1] - cpu1[1]))
    local diff_total=$((cpu2[2] - cpu1[2]))
    local usage=$((100 * (diff_total - diff_idle) / diff_total))
    
    echo "$usage%"
}

# 获取内存信息
get_memory_info() {
    local mem_info=($(free -m | awk '/Mem:/ {print $2, $3, $7}'))
    local total=${mem_info[0]}
    local used=${mem_info[1]}
    local available=${mem_info[2]}
    local used_percent=$((used * 100 / total))
    
    echo "${used}MB/${total}MB (可用:${available}MB)"
}

# 获取磁盘信息
get_disk_info() {
    df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}'
}

# 获取时间信息
get_time_info() {
    date +"%Y-%m-%d %H:%M:%S %Z"
}

# 获取网络状态
get_network_info() {
    local ip=$(ip route get 1.2.3.4 | awk '{print $7}' | head -n1)
    local ssid=$(iwgetid -r)
    local speed=$(ip -s link | awk '/state UP/{getline; print $1 " RX | " $8 " TX"}')
    
    [ -z "$ip" ] && ip="N/A"
    [ -z "$ssid" ] && ssid="有线连接"
    
    echo "$ssid | $ip | $speed"
}

# 获取温度信息
get_temp_info() {
    local temp_path="/sys/class/thermal/thermal_zone0/temp"
    if [ -f "$temp_path" ]; then
        local temp=$(cat $temp_path)
        echo "$((temp/1000))°C"
    else
        echo "N/A"
    fi
}

# 获取系统负载
get_load_info() {
    awk '{printf "1min:%.2f, 5min:%.2f, 15min:%.2f", $1, $2, $3}' /proc/loadavg
}

# 获取系统运行时间
get_uptime_info() {
    uptime -p | sed 's/up //'
}

# 主显示函数
display_system_stats() {
    clear
    
    # 顶部标题
    printf "${BLUE}%-${TERM_WIDTH}s${RESET}\n" "系统状态监控"
    print_separator
    
    # 系统信息
    print_section "⚙️ 系统信息"
    print_info "主机名" "$(hostname)"
    print_info "系统" "$(uname -srm)"
    print_info "运行时间" "$(get_uptime_info)"
    print_separator
    
    # 电池状态
    print_section "🔋 电池状态"
    print_info "电量" "$(get_battery_info)"
    print_separator
    
    # CPU状态
    print_section "🖥️ CPU状态"
    print_info "使用率" "$(get_cpu_usage)"
    print_info "温度" "$(get_temp_info)"
    print_info "负载" "$(get_load_info)"
    print_separator
    
    # 内存状态
    print_section "🧠 内存状态"
    local mem_info=($(free -m | awk '/Mem:/ {print $2, $3}'))
    print_info "使用情况" "$(get_memory_info)"
    printf "  内存占用: "
    progress_bar ${mem_info[1]} ${mem_info[0]}
    printf "\n"
    print_separator
    
    # 磁盘状态
    print_section "💾 磁盘状态"
    print_info "根分区" "$(get_disk_info)"
    print_separator
    
    # 网络状态
    print_section "🌐 网络状态"
    print_info "连接" "$(get_network_info)"
    print_separator
    
    # 时间信息
    print_section "🕒 时间信息"
    print_info "当前时间" "$(get_time_info)"
    print_separator
    
    # 底部提示
    printf "${CYAN}%-${TERM_WIDTH}s${RESET}\n" "按 Ctrl+C 退出"
}

# 主函数
main() {
    # 检查是否需要实时刷新
    if [ "$1" == "-w" ]; then
        # 实时刷新模式
        while true; do
            display_system_stats
            sleep 2
        done
    else
        # 单次显示模式
        display_system_stats
    fi
}

# 启动主函数
main "$@"
