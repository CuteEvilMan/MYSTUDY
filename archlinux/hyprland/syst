#!/bin/bash

# 系统状态监控工具
# 显示：电池状态、CPU占用、内存使用、磁盘空间、时间和网络状态

# 文本颜色定义
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
MAGENTA="\033[1;35m"
CYAN="\033[1;36m"
RESET="\033[0m"

# 获取终端宽度
TERM_WIDTH=$(tput cols)

# 分隔线函数
print_separator() {
    printf "${CYAN}%${TERM_WIDTH}s${RESET}\n" | tr ' ' '─'
}

# 带图标的标题函数
print_section() {
    printf "${MAGENTA}%s${RESET}\n" "$1"
}

# 状态信息函数
print_info() {
    printf "  ${YELLOW}%-12s${RESET} %s\n" "$1:" "$2"
}

# 进度条函数
progress_bar() {
    local value=$1
    local max=$2
    local width=20
    
    # 防止除以零错误
    if [ "$max" -le 0 ]; then
        printf "${RED}错误: 无效的最大值${RESET}"
        return
    fi
    
    local filled=$((value * width / max))
    local empty=$((width - filled))
    
    # 确保填充值不超过宽度
    if [ "$filled" -gt "$width" ]; then
        filled=$width
        empty=0
    fi
    
    printf "${GREEN}"
    printf "%${filled}s" | tr ' ' '■'
    printf "${RED}"
    printf "%${empty}s" | tr ' ' '□'
    printf "${RESET} %3d%%" "$((value * 100 / max))"
}

# 获取电池信息
get_battery_info() {
    local bat_path="/sys/class/power_supply"
    local battery_info=""
    
    # 查找电池设备
    for bat in $(ls $bat_path | grep -i BAT); do
        if [ -f "$bat_path/$bat/capacity" ]; then
            local capacity=$(cat "$bat_path/$bat/capacity" 2>/dev/null)
            local status=$(cat "$bat_path/$bat/status" 2>/dev/null)
            
            if [ -n "$capacity" ]; then
                local status_icon="?"
                [ "$status" == "Charging" ] && status_icon="⚡"
                [ "$status" == "Discharging" ] && status_icon="▼"
                [ "$status" == "Full" ] && status_icon="✓"
                
                battery_info+="${status_icon} ${capacity}% "
            fi
        fi
    done
    
    if [ -z "$battery_info" ]; then
        echo "N/A (台式机?)"
    else
        echo "$battery_info"
    fi
}

# 获取CPU使用率
get_cpu_usage() {
    # 获取两次CPU数据计算差值
    local cpu1=($(head -n1 /proc/stat | awk '{for(i=2;i<=NF;i++) sum+=$i; print $2+$3+$4+$6+$7+$8, $5, sum}'))
    sleep 0.5
    local cpu2=($(head -n1 /proc/stat | awk '{for(i=2;i<=NF;i++) sum+=$i; print $2+$3+$4+$6+$7+$8, $5, sum}'))
    
    # 计算使用率
    local diff_idle=$((cpu2[1] - cpu1[1]))
    local diff_total=$((cpu2[2] - cpu1[2]))
    
    # 防止除以零错误
    if [ "$diff_total" -le 0 ]; then
        echo "0%"
        return
    fi
    
    local usage=$((100 * (diff_total - diff_idle) / diff_total))
    
    echo "$usage%"
}

# 获取内存信息
get_memory_info() {
    # 直接从/proc/meminfo获取更可靠的数据
    local total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    local free_kb=$(grep MemFree /proc/meminfo | awk '{print $2}')
    local available_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    local buffers_kb=$(grep Buffers /proc/meminfo | awk '{print $2}')
    local cached_kb=$(grep '^Cached' /proc/meminfo | awk '{print $2}')
    
    # 计算已使用内存
    local used_kb=$((total_kb - free_kb - buffers_kb - cached_kb))
    
    # 转换为MB
    local total_mb=$((total_kb / 1024))
    local used_mb=$((used_kb / 1024))
    local available_mb=$((available_kb / 1024))
    
    echo "${used_mb}MB/${total_mb}MB (可用:${available_mb}MB)"
}

# 获取磁盘信息
get_disk_info() {
    df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}'
}

# 获取时间信息
get_time_info() {
    date +"%Y-%m-%d %H:%M:%S %Z"
}

# 获取网络状态
get_network_info() {
    # 获取IP地址（更可靠的方法）
    local ip=$(ip route get 1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
    
    # 获取SSID（无线网络）
    local ssid=""
    if command -v iwgetid &> /dev/null; then
        ssid=$(iwgetid -r)
    fi
    
    # 获取网络速度
    local rx_speed=""
    local tx_speed=""
    if [ -d /sys/class/net ]; then
        for iface in $(ls /sys/class/net); do
            # 跳过回环接口
            [ "$iface" = "lo" ] && continue
            
            # 检查接口是否启用
            if [ $(cat /sys/class/net/$iface/operstate) = "up" ]; then
                # 获取接收和发送的字节数
                rx_bytes=$(cat /sys/class/net/$iface/statistics/rx_bytes)
                tx_bytes=$(cat /sys/class/net/$iface/statistics/tx_bytes)
                
                # 转换为可读格式
                rx_speed=$(numfmt --to=iec $rx_bytes)
                tx_speed=$(numfmt --to=iec $tx_bytes)
                
                # 如果有线连接，设置ssid
                [ -z "$ssid" ] && ssid="有线连接 ($iface)"
                break
            fi
        done
    fi
    
    [ -z "$ip" ] && ip="N/A"
    [ -z "$ssid" ] && ssid="未连接"
    [ -z "$rx_speed" ] && rx_speed="N/A"
    [ -z "$tx_speed" ] && tx_speed="N/A"
    
    echo "$ssid | IP: $ip | 收: $rx_speed | 发: $tx_speed"
}

# 获取温度信息
get_temp_info() {
    # 尝试不同的温度传感器路径
    local temp_paths=(
        "/sys/class/thermal/thermal_zone0/temp"
        "/sys/class/hwmon/hwmon0/temp1_input"
        "/sys/class/hwmon/hwmon1/temp1_input"
    )
    
    for path in "${temp_paths[@]}"; do
        if [ -f "$path" ]; then
            local temp=$(cat "$path")
            # 有些传感器是毫摄氏度，有些是摄氏度
            if [ $temp -gt 10000 ]; then
                echo "$((temp/1000))°C"
            else
                echo "$((temp/1000)).$((temp%1000/100))°C"
            fi
            return
        fi
    done
    
    echo "N/A"
}

# 获取系统负载
get_load_info() {
    awk '{printf "1min:%.2f, 5min:%.2f, 15min:%.2f", $1, $2, $3}' /proc/loadavg
}

# 获取系统运行时间
get_uptime_info() {
    # 使用更可靠的uptime解析方法
    awk '{printf "%d天%d小时%d分钟", int($1/86400), int(($1%86400)/3600), int(($1%3600)/60)}' /proc/uptime
}

# 获取主机名
get_hostname() {
    # 使用/proc文件系统获取主机名
    if [ -f /proc/sys/kernel/hostname ]; then
        cat /proc/sys/kernel/hostname
    else
        echo "未知主机"
    fi
}

# 主显示函数
display_system_stats() {
    clear
    
    # 顶部标题
    printf "${BLUE}%-${TERM_WIDTH}s${RESET}\n" "系统状态监控"
    print_separator
    
    # 系统信息
    print_section "⚙️ 系统信息"
    print_info "主机名" "$(get_hostname)"
    print_info "系统" "$(uname -srm)"
    print_info "运行时间" "$(get_uptime_info)"
    print_separator
    
    # 电池状态
    print_section "🔋 电池状态"
    print_info "电量" "$(get_battery_info)"
    print_separator
    
    # CPU状态
    print_section "🖥️ CPU状态"
    print_info "使用率" "$(get_cpu_usage)"
    print_info "温度" "$(get_temp_info)"
    print_info "负载" "$(get_load_info)"
    print_separator
    
    # 内存状态
    print_section "🧠 内存状态"
    # 直接从/proc/meminfo获取数据用于进度条
    local total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    local free_kb=$(grep MemFree /proc/meminfo | awk '{print $2}')
    local buffers_kb=$(grep Buffers /proc/meminfo | awk '{print $2}')
    local cached_kb=$(grep '^Cached' /proc/meminfo | awk '{print $2}')
    local used_kb=$((total_kb - free_kb - buffers_kb - cached_kb))
    
    print_info "使用情况" "$(get_memory_info)"
    printf "  内存占用: "
    progress_bar $used_kb $total_kb
    printf "\n"
    print_separator
    
    # 磁盘状态
    print_section "💾 磁盘状态"
    print_info "根分区" "$(get_disk_info)"
    print_separator
    
    # 网络状态
    print_section "🌐 网络状态"
    print_info "连接" "$(get_network_info)"
    print_separator
    
    # 时间信息
    print_section "🕒 时间信息"
    print_info "当前时间" "$(get_time_info)"
    print_separator
    
    # 底部提示
    printf "${CYAN}%-${TERM_WIDTH}s${RESET}\n" "按 Ctrl+C 退出"
}

# 主函数
main() {
    # 检查是否需要实时刷新
    if [ "$1" == "-w" ]; then
        # 实时刷新模式
        while true; do
            display_system_stats
            sleep 2
        done
    else
        # 单次显示模式
        display_system_stats
    fi
}

# 启动主函数
main "$@"
